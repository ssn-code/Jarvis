# ==============================================================================
# JARVIS Configuration Environment Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Execution Environment: development | production | testing
ENV=development

# Presentation & API Server Settings
PRESENTATION_API_HOST=127.0.0.1
PRESENTATION_API_PORT=8000
PRESENTATION_THEME=dark
PRESENTATION_WINDOW_WIDTH=1200
PRESENTATION_WINDOW_HEIGHT=800

# OpenRouter / LLM Provider Settings
# Sign up at https://openrouter.ai/ to get an API key
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_PLANNER_MODEL=deepseek/deepseek-chat
OPENROUTER_CHAT_MODEL=qwen/qwen-2.5-32b-instruct
OPENROUTER_CODING_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_VISION_MODEL=qwen/qwen-2-vl-72b-instruct

# Local LLM Provider (Optional)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2:3b

# Database Settings
DB_SQLITE_DB_PATH=backend/brain/jarvis.db
DB_CHROMADB_DIR=backend/brain/chroma

# Voice System Settings
VOICE_WAKE_WORD=jarvis
VOICE_WHISPER_MODEL=base
VOICE_PIPER_VOICE=en_US-lessac-medium
VOICE_CONTINUOUS_LISTENING=false
VOICE_PUSH_TO_TALK=true

# Security & Sandboxing Settings
# SECURITY_ENCRYPTION_KEY can be generated via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY_ENCRYPTION_KEY=
SECURITY_DEFAULT_VERIFICATION_LEVEL=CONFIRM
SECURITY_SANDBOX_WORKSPACE=backend/brain/sandbox

# MCP (Model Context Protocol) Settings
MCP_AUTO_ACTIVATION=true
MCP_CONNECT_TIMEOUT_SECONDS=10
