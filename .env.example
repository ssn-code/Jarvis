# ==============================================================================
# JARVIS Configuration Environment Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application Environment: development | production | testing
APP_ENV=development
LOG_LEVEL=INFO

# ==============================================================================
# LLM Provider Configuration (NVIDIA API & Local Model)
# ==============================================================================
LLM_PROVIDER=nvidia
LLM_EXECUTION_MODE=cloud
LLM_ENABLE_FALLBACK=true

# NVIDIA API (Primary Cloud AI Provider)
# Get your API key at https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Local LLM Runtime (Ollama or OpenAI-compatible)
# Ideal for RTX 4050 6GB / 16GB RAM with 7B-8B quantized models
LOCAL_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.2:3b
LOCAL_RUNTIME=Ollama

# Presentation & API Server Settings
PRESENTATION_API_HOST=127.0.0.1
PRESENTATION_API_PORT=8000
PRESENTATION_THEME=dark
PRESENTATION_WINDOW_WIDTH=1200
PRESENTATION_WINDOW_HEIGHT=800

# Database Settings
DB_SQLITE_DB_PATH=backend/brain/jarvis.db
DB_CHROMADB_DIR=backend/brain/chroma

# Voice System Settings
VOICE_WAKE_WORD=jarvis
VOICE_WHISPER_MODEL=base
VOICE_PIPER_VOICE=en_US-lessac-medium
VOICE_CONTINUOUS_LISTENING=false
VOICE_PUSH_TO_TALK=true

# Security & Sandboxing Settings
SECURITY_ENCRYPTION_KEY=
SECURITY_DEFAULT_VERIFICATION_LEVEL=CONFIRM
SECURITY_SANDBOX_WORKSPACE=backend/brain/sandbox

# MCP (Model Context Protocol) Settings
MCP_AUTO_ACTIVATION=true
MCP_CONNECT_TIMEOUT_SECONDS=10
